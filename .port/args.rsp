-mcpu=cortex-m3
-std=gnu11
-g3
-O0
-ffunction-sections
-fdata-sections
-mfloat-abi=soft
-mthumb
--specs=nano.specs
-include
config.h
-include
src/core/shell/shell_cfg_user.h
-DDEBUG
-DUSE_HAL_DRIVER
-DSTM32F103xE
-DSTM32_THREAD_SAFE_STRATEGY=4
-DPORT_OS_FREERTOS=1
